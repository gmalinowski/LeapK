            </property>
            <property name="singleStep">
             <double>0.05</double>
            </property>
            <property name="value">
             <double>0.25</double>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
