<ui version="4.0">
 <class>ActiveWindowOutlineConfigForm</class>
 <widget class="QWidget" name="ActiveWindowOutlineConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>550</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- TAB 1: General Appearance -->
     <widget class="QWidget" name="tabGeneral">
      <attribute name="title">
       <string>Appearance</string>
      </attribute>
      <layout class="QFormLayout" name="formLayoutGeneral">

       <item row="0" column="0">
        <widget class="QLabel" name="label_accentColor">
         <property name="text">
          <string>Use accent color:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QCheckBox" name="kcfg_UseAccentColor">
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="1" column="0">
        <widget class="QLabel" name="label_accentOpacity">
         <property name="text">
          <string>Accent opacity:</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="kcfg_AccentOpacity">
         <property name="minimum">
          <number>0</number>
         </property>
         <property name="maximum">
          <number>100</number>
         </property>
         <property name="value">
          <number>66</number>
         </property>
         <property name="suffix">
          <string> %</string>
         </property>
        </widget>
       </item>

       <item row="2" column="0">
        <widget class="QLabel" name="label_customColor">
         <property name="text">
          <string>Custom color:</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="KColorButton" name="kcfg_CustomColor">
         <property name="alphaChannelEnabled">
          <bool>true</bool>
         </property>
         <property name="color">
          <color alpha="255">
           <red>61</red>
           <green>174</green>
           <blue>233</blue>
          </color>
         </property>
        </widget>
       </item>

       <item row="3" column="0">
        <widget class="QLabel" name="label_borderWidth">
         <property name="text">
          <string>Border width:</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QSpinBox" name="kcfg_BorderWidth">
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>20</number>
         </property>
         <property name="value">
          <number>2</number>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
        </widget>
       </item>

       <item row="4" column="0">
        <widget class="QLabel" name="label_outlineGap">
         <property name="text">
          <string>Outline offset:</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QSpinBox" name="kcfg_OutlineGap">
         <property name="minimum">
          <number>0</number>
         </property>
         <property name="maximum">
          <number>30</number>
         </property>
         <property name="value">
          <number>0</number>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
        </widget>
       </item>

       <item row="5" column="0">
        <widget class="QLabel" name="label_borderRadius">
         <property name="text">
          <string>Border radius:</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QSpinBox" name="kcfg_BorderRadius">
         <property name="minimum">
          <number>0</number>
         </property>
         <property name="maximum">
          <number>30</number>
         </property>
         <property name="value">
          <number>6</number>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
        </widget>
       </item>

       <item row="6" column="0">
        <widget class="QLabel" name="label_drawInside">
         <property name="text">
          <string>Draw inside window:</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="kcfg_DrawInside">
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="7" column="0" colspan="2">
        <widget class="QCheckBox" name="kcfg_SmoothEdges">
         <property name="text">
          <string>Smooth edges</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="8" column="0" colspan="2">
        <widget class="QCheckBox" name="kcfg_GlowEnabled">
         <property name="text">
          <string>Soft glow</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="9" column="0">
        <widget class="QLabel" name="label_glowRadius">
         <property name="text">
          <string>Glow size:</string>
         </property>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QSpinBox" name="kcfg_GlowRadius">
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>30</number>
         </property>
         <property name="value">
          <number>6</number>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
        </widget>
       </item>

       <item row="10" column="0" colspan="2">
        <widget class="QCheckBox" name="kcfg_HideOnFullScreen">
         <property name="text">
          <string>Hide on fullscreen</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="11" column="0" colspan="2">
        <widget class="QLabel" name="label_info">
         <property name="text">
          <string>ℹ️ “Draw inside” keeps the outline visible on maximized and tiled windows. When disabled, the outline is drawn outside the window.</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="12" column="0">
        <widget class="QLabel" name="label_version">
         <property name="text">
          <string>Version:</string>
         </property>
        </widget>
       </item>
       <item row="12" column="1">
        <widget class="QLabel" name="label_versionValue">
         <property name="text">
          <string>development</string>
         </property>
         <property name="textInteractionFlags">
          <set>Qt::TextSelectableByMouse</set>
         </property>
        </widget>
       </item>

      </layout>
     </widget>

     <!-- TAB 2: Color Cycling -->
     <widget class="QWidget" name="tabColors">
      <attribute name="title">
       <string>Color Sequence</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutColors">

       <item>
        <widget class="QCheckBox" name="kcfg_ColorCycleEnabled">
         <property name="text">
          <string>Enable color cycling animation</string>
         </property>
         <property name="checked">
          <bool>false</bool>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QLabel" name="label_colorSequenceHelp">
         <property name="text">
          <string>Add colors to cycle through. Double-click a row to change its color or hold time.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item>
        <widget class="QTableWidget" name="tableColors">
         <property name="selectionBehavior">
          <enum>QAbstractItemView::SelectRows</enum>
         </property>
         <property name="selectionMode">
          <enum>QAbstractItemView::SingleSelection</enum>
         </property>
         <column>
          <property name="text">
           <string>Color</string>
          </property>
         </column>
         <column>
          <property name="text">
           <string>Hold Time (s)</string>
          </property>
         </column>
        </widget>
       </item>

       <item>
        <layout class="QHBoxLayout" name="horizontalLayoutColorButtons">
         <item>
          <widget class="QPushButton" name="btnAddColor">
           <property name="text">
            <string>+ Add Color…</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnRemoveColor">
           <property name="text">
            <string>- Remove</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnMoveUp">
           <property name="text">
            <string>▲ Up</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnMoveDown">
           <property name="text">
            <string>▼ Down</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QGroupBox" name="groupTransition">
         <property name="title">
          <string>Transition Settings</string>
         </property>
         <layout class="QFormLayout" name="formLayoutTransition">
          <item row="0" column="0">
           <widget class="QLabel" name="label_transitionDuration">
            <property name="text">
             <string>Transition duration:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_ColorTransitionDuration">
            <property name="minimum">
             <double>0.1</double>
            </property>
            <property name="maximum">
             <double>30.0</double>
            </property>
            <property name="singleStep">
             <double>0.5</double>
            </property>
            <property name="value">
             <double>2.0</double>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>

          <item row="1" column="0">
           <widget class="QLabel" name="label_cycleOrder">
            <property name="text">
             <string>Sequence order:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="kcfg_ColorCycleOrder">
            <item>
             <property name="text">
              <string>Sequential</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Random</string>
             </property>
            </item>
           </widget>
          </item>

          <item row="2" column="0">
           <widget class="QLabel" name="label_cycleEasing">
            <property name="text">
             <string>Transition easing (CSS style):</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="kcfg_ColorCycleEasing">
            <item>
             <property name="text">
              <string>Ease In Out (Smoothstep)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Linear</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Ease In (Accelerating)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Ease Out (Decelerating)</string>
             </property>
            </item>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

      </layout>
     </widget>

     <!-- TAB 3: Shader Effects -->
     <widget class="QWidget" name="tabEffects">
      <attribute name="title">
       <string>Shader Effects</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutEffects">

       <item>
        <widget class="QGroupBox" name="groupBreathe">
         <property name="title">
          <string>Breathe / Pulsing</string>
         </property>
         <layout class="QFormLayout" name="formLayoutBreathe">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_BreatheEnabled">
            <property name="text">
             <string>Enable breathing pulse</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_breatheSpeed">
            <property name="text">
             <string>Pulse speed:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_BreatheSpeed">
            <property name="minimum">
             <double>0.1</double>
            </property>
            <property name="maximum">
             <double>10.0</double>
            </property>
            <property name="singleStep">
             <double>0.2</double>
            </property>
            <property name="value">
             <double>1.5</double>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_breatheIntensity">
            <property name="text">
             <string>Pulse intensity:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="kcfg_BreatheIntensity">
            <property name="minimum">
             <number>10</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>40</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupGlitch">
         <property name="title">
          <string>Futuristic Glitch</string>
         </property>
         <layout class="QFormLayout" name="formLayoutGlitch">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_GlitchEnabled">
            <property name="text">
             <string>Enable sci-fi holographic glitches</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_glitchSpeed">
            <property name="text">
             <string>Animation speed:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_GlitchSpeed">
            <property name="minimum">
             <double>0.1</double>
            </property>
            <property name="maximum">
             <double>5.0</double>
            </property>
            <property name="singleStep">
             <double>0.2</double>
            </property>
            <property name="value">
             <double>1.0</double>
            </property>
            <property name="suffix">
             <string>x</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_glitchFrequency">
            <property name="text">
             <string>Glitch frequency:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="kcfg_GlitchFrequency">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>10</number>
            </property>
            <property name="value">
             <number>3</number>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_glitchIntensity">
            <property name="text">
             <string>Glitch intensity:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QSpinBox" name="kcfg_GlitchIntensity">
            <property name="minimum">
             <number>10</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>50</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupNeonFlicker">
         <property name="title">
          <string>Neon Flicker</string>
         </property>
         <layout class="QFormLayout" name="formLayoutNeon">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_NeonFlickerEnabled">
            <property name="text">
             <string>Enable neon voltage flicker</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_neonInterval">
            <property name="text">
             <string>Flicker interval:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_NeonFlickerInterval">
            <property name="minimum">
             <double>0.5</double>
            </property>
            <property name="maximum">
             <double>30.0</double>
            </property>
            <property name="singleStep">
             <double>0.5</double>
            </property>
            <property name="value">
             <double>3.0</double>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_neonDuration">
            <property name="text">
             <string>Flicker duration:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_NeonFlickerDuration">
            <property name="minimum">
             <double>0.05</double>
            </property>
            <property name="maximum">
             <double>2.0</double>
            </property>
            <property name="singleStep">
             <double>0.05</double>
            </property>
            <property name="value">
             <double>0.25</double>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_neonIntensity">
            <property name="text">
             <string>Flicker intensity:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QSpinBox" name="kcfg_NeonFlickerIntensity">
            <property name="minimum">
             <number>10</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>30</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
