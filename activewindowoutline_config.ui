<ui version="4.0">
 <class>ActiveWindowOutlineConfigForm</class>
 <widget class="QWidget" name="ActiveWindowOutlineConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>450</height>
   </rect>
  </property>
  <layout class="QFormLayout" name="formLayout">

   <item row="0" column="0">
    <widget class="QLabel" name="label_accentColor">
     <property name="text">
      <string>Use accent color:</string>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QCheckBox" name="kcfg_UseAccentColor">
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item row="1" column="0">
    <widget class="QLabel" name="label_accentOpacity">
     <property name="text">
      <string>Accent opacity:</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="kcfg_AccentOpacity">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>100</number>
     </property>
     <property name="value">
      <number>66</number>
     </property>
     <property name="suffix">
      <string> %</string>
     </property>
    </widget>
   </item>

   <item row="2" column="0">
    <widget class="QLabel" name="label_customColor">
     <property name="text">
      <string>Custom color:</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="KColorButton" name="kcfg_CustomColor">
     <property name="alphaChannelEnabled">
      <bool>true</bool>
     </property>
     <property name="color">
      <color alpha="255">
       <red>61</red>
       <green>174</green>
       <blue>233</blue>
      </color>
     </property>
    </widget>
   </item>

   <item row="3" column="0">
    <widget class="QLabel" name="label_borderWidth">
     <property name="text">
      <string>Border width:</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QSpinBox" name="kcfg_BorderWidth">
     <property name="minimum">
      <number>1</number>
     </property>
     <property name="maximum">
      <number>20</number>
     </property>
     <property name="value">
      <number>4</number>
     </property>
     <property name="suffix">
      <string> px</string>
     </property>
    </widget>
   </item>

   <item row="4" column="0">
    <widget class="QLabel" name="label_outlineGap">
     <property name="text">
      <string>Outline offset:</string>
     </property>
    </widget>
   </item>
   <item row="4" column="1">
    <widget class="QSpinBox" name="kcfg_OutlineGap">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>30</number>
     </property>
     <property name="value">
      <number>0</number>
     </property>
     <property name="suffix">
      <string> px</string>
     </property>
    </widget>
   </item>

   <item row="5" column="0">
    <widget class="QLabel" name="label_borderRadius">
     <property name="text">
      <string>Border radius:</string>
     </property>
    </widget>
   </item>
   <item row="5" column="1">
    <widget class="QSpinBox" name="kcfg_BorderRadius">
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>30</number>
     </property>
     <property name="value">
      <number>5</number>
     </property>
     <property name="suffix">
      <string> px</string>
     </property>
    </widget>
   </item>

   <item row="6" column="0">
    <widget class="QLabel" name="label_drawInside">
     <property name="text">
      <string>Draw inside window:</string>
     </property>
    </widget>
   </item>
   <item row="6" column="1">
    <widget class="QCheckBox" name="kcfg_DrawInside">
     <property name="checked">
      <bool>false</bool>
     </property>
    </widget>
   </item>

   <item row="7" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_SmoothEdges">
     <property name="text">
      <string>Smooth edges</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item row="8" column="0" colspan="2">
    <widget class="QCheckBox" name="kcfg_GlowEnabled">
     <property name="text">
      <string>Soft glow</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item row="9" column="0">
    <widget class="QLabel" name="label_glowRadius">
     <property name="text">
      <string>Glow size:</string>
     </property>
    </widget>
   </item>
   <item row="9" column="1">
    <widget class="QSpinBox" name="kcfg_GlowRadius">
     <property name="minimum">
      <number>1</number>
     </property>
     <property name="maximum">
      <number>30</number>
     </property>
     <property name="value">
      <number>6</number>
     </property>
     <property name="suffix">
      <string> px</string>
     </property>
    </widget>
   </item>

   <item row="10" column="0" colspan="2">
    <widget class="QLabel" name="label_info">
     <property name="text">
      <string>ℹ️ Offset moves the outline away from the window edge. “Draw inside” keeps it visible on maximized and tiled windows. Glow adds a soft colored halo around the outline.</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item row="11" column="0">
    <widget class="QLabel" name="label_version">
     <property name="text">
      <string>Version:</string>
     </property>
    </widget>
   </item>
   <item row="11" column="1">
    <widget class="QLabel" name="label_versionValue">
     <property name="text">
      <string>development</string>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
    </widget>
