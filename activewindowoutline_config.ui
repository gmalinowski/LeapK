      </layout>
     </widget>

     <!-- TAB 4: Behavior & Buffer Delays -->
     <widget class="QWidget" name="tabBehavior">
      <attribute name="title">
       <string>Behavior</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutBehavior">

       <item>
        <widget class="QGroupBox" name="groupTransitions">
         <property name="title">
          <string>Transitions &amp; Fading</string>
         </property>
         <layout class="QFormLayout" name="formLayoutTransitions">
          <item row="0" column="0" colspan="2">
           <widget class="QLabel" name="label_transitionDescription">
            <property name="text">
             <string>Smoothly fades the outline in and out when appearing, disappearing, or switching windows.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_fadeDuration">
            <property name="text">
             <string>Fade transition duration:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="kcfg_FadeDuration">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>1000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>200</number>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="specialValueText">
             <string>Instant (0 ms)</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupMenuDelays">
         <property name="title">
          <string>Context Menus &amp; Popups</string>
         </property>
         <layout class="QFormLayout" name="formLayoutMenuDelays">
          <item row="0" column="0" colspan="2">
           <widget class="QLabel" name="label_menuDescription">
            <property name="text">
             <string>Buffering prevents the outline from flickering when opening context menus or navigating between submenus.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_menuHideDelay">
            <property name="text">
             <string>Menu hide delay (buffer):</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="kcfg_MenuHideDelay">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>2000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>300</number>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="specialValueText">
             <string>Instant (0 ms)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_menuShowDelay">
            <property name="text">
             <string>Menu show delay (buffer):</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="kcfg_MenuShowDelay">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>2000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>300</number>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="specialValueText">
             <string>Instant (0 ms)</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupWindowDelays">
         <property name="title">
          <string>Window Switching</string>
         </property>
         <layout class="QFormLayout" name="formLayoutWindowDelays">
          <item row="0" column="0" colspan="2">
           <widget class="QLabel" name="label_windowDescription">
            <property name="text">
             <string>Buffering when switching active windows (e.g. for focus-follows-mouse or rapid window cycling).</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_windowHideDelay">
            <property name="text">
             <string>Switch hide delay:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="kcfg_WindowHideDelay">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>2000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="specialValueText">
             <string>Instant (0 ms)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_windowShowDelay">
            <property name="text">
             <string>Switch show delay:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="kcfg_WindowShowDelay">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>2000</number>
            </property>
            <property name="singleStep">
             <number>50</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="specialValueText">
             <string>Instant (0 ms)</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupRecentWindow">
         <property name="title">
          <string>Previous (Recent) Window Highlight</string>
         </property>
         <layout class="QFormLayout" name="formLayoutRecentWindow">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_HighlightRecentWindow">
            <property name="text">
             <string>Keep outline on previously active window(s)</string>
            </property>
            <property name="toolTip">
             <string>Draws a subdued outline around recent windows to help track focus history when multitasking or tiling windows.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_recentWindowsCount">
            <property name="text">
             <string>Recent windows count:</string>
            </property>
            <property name="toolTip">
             <string>How many previously focused windows to highlight (1–5).</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowsCount">
            <property name="toolTip">
             <string>How many previously focused windows to highlight (1–5).</string>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>5</number>
            </property>
            <property name="value">
             <number>1</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_recentWindowColorMode">
            <property name="text">
             <string>Recent outline color:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="kcfg_RecentWindowColorMode">
            <item>
             <property name="text">
              <string>Match active window color</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Custom static color</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_recentWindowCustomColor">
            <property name="text">
             <string>Custom color:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="KColorButton" name="kcfg_RecentWindowCustomColor">
            <property name="alphaChannelEnabled">
             <bool>true</bool>
            </property>
            <property name="color">
             <color alpha="255">
              <red>127</red>
              <green>140</green>
              <blue>141</blue>
             </color>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_recentWindowOpacity">
            <property name="text">
             <string>Oldest window opacity (fades with age):</string>
            </property>
            <property name="toolTip">
             <string>Sets the minimum outline opacity reached by the oldest window in the focus history (e.g. 20%). Each window in history fades progressively with age, linearly interpolating between 100% (active window) down to this floor for the oldest window.</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowOpacity">
            <property name="toolTip">
             <string>Sets the minimum outline opacity reached by the oldest window in the focus history (e.g. 20%). Each window in history fades progressively with age, linearly interpolating between 100% (active window) down to this floor for the oldest window.</string>
            </property>
            <property name="minimum">
             <number>5</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="singleStep">
             <number>5</number>
            </property>
            <property name="value">
             <number>20</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="label_recentWindowHueShift">
            <property name="text">
             <string>Hue shift per window:</string>
            </property>
            <property name="toolTip">
             <string>Rotates the color hue for each successive previous window on the color wheel (0°: no hue change, positive: clockwise e.g. blue to purple, negative: counter-clockwise e.g. blue to green). In Match Active mode, shifting begins on the 1st recent window; in Custom Color mode, the 1st recent window keeps the exact chosen color and shifting begins on the 2nd recent window.</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowHueShift">
            <property name="toolTip">
             <string>Rotates the color hue for each successive previous window on the color wheel (0°: no hue change, positive: clockwise e.g. blue to purple, negative: counter-clockwise e.g. blue to green). In Match Active mode, shifting begins on the 1st recent window; in Custom Color mode, the 1st recent window keeps the exact chosen color and shifting begins on the 2nd recent window.</string>
            </property>
            <property name="minimum">
             <number>-180</number>
            </property>
            <property name="maximum">
             <number>180</number>
            </property>
            <property name="singleStep">
             <number>5</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="suffix">
             <string> °</string>
            </property>
            <property name="specialValueText">
             <string>0 ° (no shift)</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="label_recentWindowSaturation">
            <property name="text">
             <string>Oldest window saturation (fades to gray):</string>
            </property>
            <property name="toolTip">
             <string>Sets the color saturation floor reached by the oldest window in the focus history (0% = monochrome grayscale, 100% = full color). Each window in history progressively loses saturation with age, fading gradually from vibrant color into muted tones and grayscale.</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowSaturation">
            <property name="toolTip">
             <string>Sets the color saturation floor reached by the oldest window in the focus history (0% = monochrome grayscale, 100% = full color). Each window in history progressively loses saturation with age, fading gradually from vibrant color into muted tones and grayscale.</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="singleStep">
             <number>5</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
            <property name="specialValueText">
             <string>0 % (Grayscale)</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0">
           <widget class="QLabel" name="label_recentWindowWidthReduction">
            <property name="text">
             <string>Width reduction per window:</string>
            </property>
            <property name="toolTip">
             <string>Reduces the outline border width for each successive older window by this amount in pixels (default: 0 px / same width). Once an outline reaches 1 px, it stays at 1 px.</string>
            </property>
           </widget>
          </item>
          <item row="7" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowWidthReduction">
            <property name="toolTip">
             <string>Reduces the outline border width for each successive older window by this amount in pixels (default: 0 px / same width). Once an outline reaches 1 px, it stays at 1 px.</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>10</number>
            </property>
            <property name="singleStep">
             <number>1</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="suffix">
             <string> px</string>
            </property>
            <property name="specialValueText">
             <string>0 px (same width)</string>
            </property>
           </widget>
          </item>
          <item row="8" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_RecentWindowDashed">
            <property name="text">
             <string>Dashed outline for previous windows (gaps widen with age)</string>
            </property>
            <property name="toolTip">
             <string>Renders recent window outlines with a dashed line pattern instead of a solid line. Older windows in the history have progressively wider gaps between dashes.</string>
            </property>
           </widget>
          </item>
          <item row="9" column="0">
           <widget class="QLabel" name="label_recentWindowGapGrowth">
            <property name="text">
             <string>Gap growth per window:</string>
            </property>
            <property name="toolTip">
             <string>Defines how much the gap between dashes increases for each successive older window in pixels (default: 6 px). If set to 0 px, all recent windows use the same constant gap length.</string>
            </property>
           </widget>
          </item>
          <item row="9" column="1">
           <widget class="QSpinBox" name="kcfg_RecentWindowGapGrowth">
            <property name="toolTip">
             <string>Defines how much the gap between dashes increases for each successive older window in pixels (default: 6 px). If set to 0 px, all recent windows use the same constant gap length.</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>30</number>
            </property>
            <property name="singleStep">
             <number>1</number>
            </property>
            <property name="value">
             <number>6</number>
            </property>
            <property name="suffix">
             <string> px</string>
            </property>
            <property name="specialValueText">
             <string>0 px (constant gaps)</string>
            </property>
           </widget>
          </item>
          <item row="10" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_RecentWindowDashSmooth">
            <property name="text">
             <string>Smooth dash transitions (soft fading)</string>
            </property>
            <property name="toolTip">
             <string>Applies a smooth alpha gradient fade between dashes and gaps instead of crisp cutoffs.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="groupWindowStates">
         <property name="title">
          <string>Window State</string>
         </property>
         <layout class="QFormLayout" name="formLayoutWindowStates">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_HideOnFullScreen">
            <property name="text">
             <string>Hide outline on fullscreen windows</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <spacer name="verticalSpacerBehavior">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>

      </layout>
     </widget>


    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>KColorButton</class>
   <extends>QPushButton</extends>
   <header>kcolorbutton.h</header>
  </customwidget>
 </customwidgets>
</ui>
