<ui version="4.0">
 <class>ActiveWindowOutlineConfigForm</class>
 <widget class="QWidget" name="ActiveWindowOutlineConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>550</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- TAB 1: General Appearance -->
     <widget class="QWidget" name="tabGeneral">
      <attribute name="title">
       <string>Appearance</string>
      </attribute>
      <layout class="QFormLayout" name="formLayoutGeneral">

       <item row="0" column="0">
        <widget class="QLabel" name="label_accentColor">
         <property name="text">
          <string>Use accent color:</string>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QCheckBox" name="kcfg_UseAccentColor">
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="1" column="0">
        <widget class="QLabel" name="label_accentOpacity">
         <property name="text">
          <string>Accent opacity:</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="kcfg_AccentOpacity">
         <property name="minimum">
          <number>0</number>
         </property>
         <property name="maximum">
          <number>100</number>
         </property>
         <property name="value">
          <number>66</number>
         </property>
         <property name="suffix">
          <string> %</string>
         </property>
        </widget>
       </item>

       <item row="2" column="0">
        <widget class="QLabel" name="label_customColor">
         <property name="text">
          <string>Custom color:</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="KColorButton" name="kcfg_CustomColor">
         <property name="alphaChannelEnabled">
          <bool>true</bool>
         </property>
         <property name="color">
          <color alpha="255">
           <red>61</red>
           <green>174</green>
           <blue>233</blue>
          </color>
         </property>
        </widget>
       </item>

       <item row="3" column="0" colspan="2">
        <widget class="QCheckBox" name="kcfg_EnsurePerimeterContrast">
         <property name="text">
          <string>Ensure perimeter contrast (adapt outline if it blends with window or wallpaper)</string>
         </property>
         <property name="toolTip">
          <string>Monitors the window perimeter and the desktop wallpaper behind the outline. If the outline color blends into the window border or desktop background, brightness, saturation, and hue are dynamically adjusted to maintain crisp visibility across all color modes.</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>

       <item row="4" column="0" colspan="2">
        <widget class="QGroupBox" name="groupAmbilight">
         <property name="title">
          <string>Ambilight (Adaptive Window Color)</string>
         </property>
         <layout class="QFormLayout" name="formLayoutAmbilight">
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="kcfg_AmbilightEnabled">
            <property name="text">
             <string>Extract outline color dynamically from active window content</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_ambilightPreset">
            <property name="text">
             <string>Preset:</string>
            </property>
            <property name="toolTip">
             <string>Select a preconfigured profile or fine-tune individual settings manually.</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout" name="layoutAmbilightPreset">
            <item>
             <widget class="QComboBox" name="comboAmbilightPreset">
              <property name="toolTip">
               <string>Select a preconfigured profile or fine-tune individual settings manually.</string>
              </property>
              <item>
               <property name="text">
                <string>Custom</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Balanced (Default)</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Vivid &amp; Dynamic</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Subtle &amp; Calm</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Eco (Battery Saver)</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>High Contrast</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>True Ambilight (Video / Cinema)</string>
               </property>
              </item>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="btnAmbilightHelp">
              <property name="text">
               <string>?</string>
              </property>
              <property name="toolTip">
               <string>Click for detailed explanation of all Ambilight parameters and presets</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_ambilightMode">
            <property name="text">
             <string>Detection mode:</string>
            </property>
            <property name="toolTip">
             <string>Algorithm used to extract the accent color from window pixels.</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="kcfg_AmbilightMode">
            <property name="toolTip">
             <string>Smart Adaptive (Hybrid): Evaluates dominant accent against window average, boosting vibrance when colors align. Dominant accent: Decisively locks onto prominent vibrant accents. Balanced average: Smoothly blends all window colors into an averaged tone.</string>
            </property>
            <item>
             <property name="text">
              <string>Smart Adaptive (Hybrid)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Dominant accent</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Balanced average</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_ambilightOpacity">
            <property name="text">
             <string>Opacity:</string>
            </property>
            <property name="toolTip">
             <string>Outline opacity level (0% is completely transparent, 100% is fully opaque).</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QSpinBox" name="kcfg_AmbilightOpacity">
            <property name="toolTip">
             <string>Outline opacity level (0% is completely transparent, 100% is fully opaque).</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>100</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_ambilightFrequency">
            <property name="text">
             <string>Sampling frequency:</string>
            </property>
            <property name="toolTip">
             <string>How often (in Hz) window colors are analyzed. 1.5 Hz is recommended for desktop work; higher values provide instant reaction to video.</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_AmbilightFrequency">
            <property name="toolTip">
             <string>How often (in Hz) window colors are analyzed. 1.5 Hz is recommended for desktop work; higher values provide instant reaction to video.</string>
            </property>
            <property name="minimum">
             <double>0.1</double>
            </property>
            <property name="maximum">
             <double>10.0</double>
            </property>
            <property name="singleStep">
             <double>0.5</double>
            </property>
            <property name="value">
             <double>1.5</double>
            </property>
            <property name="suffix">
             <string> Hz</string>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="label_ambilightDuration">
            <property name="text">
             <string>Transition duration:</string>
            </property>
            <property name="toolTip">
             <string>Crossfade duration (in seconds) when animating between previous and newly sampled outline colors.</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QDoubleSpinBox" name="kcfg_AmbilightDuration">
            <property name="toolTip">
             <string>Crossfade duration (in seconds) when animating between previous and newly sampled outline colors.</string>
            </property>
            <property name="minimum">
             <double>0.1</double>
            </property>
            <property name="maximum">
             <double>5.0</double>
            </property>
            <property name="singleStep">
             <double>0.1</double>
            </property>
            <property name="value">
             <double>0.5</double>
            </property>
            <property name="suffix">
             <string> s</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="label_ambilightSaturationLeveling">
            <property name="text">
             <string>Saturation leveling:</string>
            </property>
            <property name="toolTip">
             <string>Normalizes outline saturation: softens overly harsh neon colors and boosts pale, weak colors towards the target level.</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QSpinBox" name="kcfg_AmbilightSaturationLeveling">
            <property name="toolTip">
             <string>Normalizes outline saturation: softens overly harsh neon colors and boosts pale, weak colors towards the target level.</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>65</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0">
           <widget class="QLabel" name="label_ambilightFallbackStrength">
            <property name="text">
             <string>Fallback distinction:</string>
            </property>
            <property name="toolTip">
             <string>Controls how strongly the outline is modified to stand out when window content matches the dominant accent in Smart Adaptive mode (0%: subtle/identical, 100%: strong contrast &amp; vibrance pop).</string>
            </property>
           </widget>
          </item>
          <item row="7" column="1">
           <widget class="QSpinBox" name="kcfg_AmbilightFallbackStrength">
            <property name="toolTip">
             <string>Controls how strongly the outline is modified to stand out when window content matches the dominant accent in Smart Adaptive mode (0%: subtle/identical, 100%: strong contrast &amp; vibrance pop).</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>50</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="8" column="0">
           <widget class="QLabel" name="label_ambilightMinBrightness">
            <property name="text">
             <string>Minimum brightness:</string>
            </property>
            <property name="toolTip">
             <string>Prevents the outline from becoming too dark on black or dark-mode windows.</string>
            </property>
           </widget>
          </item>
          <item row="8" column="1">
           <widget class="QSpinBox" name="kcfg_AmbilightMinBrightness">
            <property name="toolTip">
             <string>Prevents the outline from becoming too dark on black or dark-mode windows.</string>
            </property>
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>50</number>
            </property>
            <property name="value">
             <number>25</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="9" column="0">
           <widget class="QLabel" name="label_ambilightMaxBrightness">
            <property name="text">
             <string>Maximum brightness:</string>
            </property>
            <property name="toolTip">
             <string>Prevents the outline from being blindingly bright on pure white windows or bright documents.</string>
            </property>
           </widget>
          </item>
          <item row="9" column="1">
           <widget class="QSpinBox" name="kcfg_AmbilightMaxBrightness">
            <property name="toolTip">
             <string>Prevents the outline from being blindingly bright on pure white windows or bright documents.</string>
            </property>
            <property name="minimum">
             <number>50</number>
            </property>
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>85</number>
            </property>
            <property name="suffix">
             <string> %</string>
            </property>
           </widget>
          </item>
          <item row="10" column="0" colspan="2">
           <widget class="QLabel" name="label_ambilightWarning">
            <property name="text">
             <string>💡 Tip: 1.5 Hz is ideal for everyday desktop tasks and web browsing. For movies, video streams, or gaming, higher frequencies (like 3.0–6.0 Hz in Vivid or True Ambilight) provide seamless real-time color tracking.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

