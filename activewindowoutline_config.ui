           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnMoveDown">
           <property name="text">
            <string>▼ Down</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QGroupBox" name="groupTransition">
         <property name="title">
          <string>Transition Settings</string>
         </property>
         <layout class="QFormLayout" name="formLayoutTransition">
          <item row="0" column="0">
           <widget class="QLabel" name="label_transitionDuration">
