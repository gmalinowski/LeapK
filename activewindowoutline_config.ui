         </item>
         <item>
          <widget class="QPushButton" name="btnRemoveColor">
           <property name="text">
            <string>- Remove</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnMoveUp">
           <property name="text">
