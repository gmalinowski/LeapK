<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="kwinrc"/>
    <group name="Effect-leapk">
        <entry name="UseAccentColor" type="Bool">
            <default>true</default>
        </entry>
        <entry name="AccentOpacity" type="Int">
            <default>66</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="CustomColor" type="Color">
            <default>#3daee9</default>
        </entry>
        <entry name="EnsurePerimeterContrast" type="Bool">
            <default>true</default>
        </entry>

        <!-- Ambilight Settings -->
        <entry name="AmbilightEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="AmbilightMode" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="AmbilightOpacity" type="Int">
            <default>100</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="AmbilightFrequency" type="Double">
            <default>1.5</default>
            <min>0.1</min>
            <max>10.0</max>
        </entry>
        <entry name="AmbilightDuration" type="Double">
            <default>0.5</default>
            <min>0.1</min>
            <max>5.0</max>
        </entry>
        <entry name="AmbilightSaturationLeveling" type="Int">
            <default>65</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="AmbilightFallbackStrength" type="Int">
            <default>50</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="AmbilightMinBrightness" type="Int">
            <default>25</default>
            <min>0</min>
            <max>50</max>
        </entry>
        <entry name="AmbilightMaxBrightness" type="Int">
            <default>85</default>
            <min>50</min>
            <max>100</max>
        </entry>
        <entry name="AmbilightEnsureContrast" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BorderWidth" type="Int">
            <default>2</default>
            <min>1</min>
            <max>100</max>
        </entry>
        <entry name="OutlineGap" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BorderRadius" type="Int">
            <default>6</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="FadeCorners" type="Bool">
            <default>true</default>
        </entry>
        <entry name="DrawInside" type="Bool">
            <default>true</default>
        </entry>
        <entry name="SmoothEdges" type="Bool">
            <default>true</default>
        </entry>
        <entry name="GlowEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="GlowRadius" type="Int">
            <default>6</default>
            <min>1</min>
            <max>200</max>
        </entry>
        <entry name="HideOnFullScreen" type="Bool">
            <default>true</default>
        </entry>
        <entry name="TrayIconEnabled" type="Bool">
            <default>true</default>
        </entry>

        <!-- Behavior & Buffer Delays -->
        <entry name="FadeDuration" type="Int">
            <default>200</default>
            <min>0</min>
            <max>1000</max>
        </entry>
        <entry name="MenuHideDelay" type="Int">
            <default>500</default>
            <min>0</min>
            <max>2000</max>
        </entry>
        <entry name="MenuShowDelay" type="Int">
            <default>500</default>
            <min>0</min>
            <max>2000</max>
        </entry>
        <entry name="WindowHideDelay" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2000</max>
        </entry>
        <entry name="WindowShowDelay" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2000</max>
        </entry>

        <!-- Recent Window Highlight Settings -->
        <entry name="HighlightRecentWindow" type="Bool">
            <default>false</default>
        </entry>
        <entry name="RecentWindowsCount" type="Int">
            <default>1</default>
            <min>1</min>
            <max>5</max>
        </entry>
        <entry name="RecentWindowColorMode" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <entry name="RecentWindowCustomColor" type="Color">
            <default>#7f8c8d</default>
        </entry>
        <entry name="RecentWindowOpacity" type="Int">
            <default>20</default>
            <min>5</min>
            <max>100</max>
        </entry>
        <entry name="RecentWindowHueShift" type="Int">
            <default>0</default>
            <min>-180</min>
            <max>180</max>
        </entry>
        <entry name="RecentWindowSaturation" type="Int">
            <default>0</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="RecentWindowWidthReduction" type="Int">
            <default>0</default>
            <min>0</min>
            <max>10</max>
        </entry>
        <entry name="RecentWindowDashed" type="Bool">
            <default>false</default>
        </entry>
        <entry name="RecentWindowGapGrowth" type="Int">
            <default>6</default>
            <min>0</min>
            <max>30</max>
        </entry>
        <entry name="RecentWindowDashSmooth" type="Bool">
            <default>false</default>
        </entry>

        <!-- Mark Window Settings -->
        <entry name="MarkDefaultColor" type="Color">
            <default>#e74c3c</default>
        </entry>
        <entry name="MarkSmartAdaptive" type="Bool">
            <default>true</default>
        </entry>
        <entry name="MarkRandomColor" type="Bool">
            <default>false</default>
        </entry>
        <!-- Precedence / Priority Settings -->
        <entry name="StylePrecedence" type="String">
            <default>Marked,Active,Recent</default>
        </entry>
        <entry name="MarkInactiveWidthReduction" type="Int">
            <default>1</default>
            <min>0</min>
            <max>10</max>
        </entry>
        <entry name="MarkInactiveDashed" type="Bool">
            <default>true</default>
        </entry>
        <entry name="MarkInactiveDashGap" type="Int">
            <default>6</default>
            <min>1</min>
            <max>40</max>
        </entry>
        <entry name="MarkInactiveDashSmooth" type="Bool">
            <default>true</default>
        </entry>
        <entry name="MarkShowLetterBadges" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgesAlwaysVisible" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeDisplayMode" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="BadgeWindowBadgesEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgePosition" type="Int">
            <default>1</default>
            <min>0</min>
            <max>8</max>
        </entry>
        <entry name="BadgeSize" type="Int">
            <default>28</default>
            <min>16</min>
            <max>500</max>
        </entry>
        <entry name="BadgeMargin" type="Int">
            <default>0</default>
            <min>0</min>
            <max>500</max>
        </entry>
        <entry name="BadgeTimeout" type="Int">
            <default>5</default>
            <min>0</min>
            <max>300</max>
        </entry>
        <entry name="JumpRecentKey" type="String">
            <default>Space</default>
        </entry>
        <entry name="JumpTargets" type="Int">
            <default>0</default>
            <min>0</min>
            <max>3</max>
        </entry>
        <entry name="CursorWarpMode" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="SoundFeedbackEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="SoundFeedbackVolume" type="Int">
            <default>30</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="BadgeHudPosition" type="Int">
            <default>0</default>
            <min>0</min>
            <max>3</max>
        </entry>
        <entry name="BadgeHudIncludeAll" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeHudGroupWindows" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeHudGroupBorderWidth" type="Double">
            <default>2.0</default>
            <min>1.0</min>
            <max>20.0</max>
        </entry>
        <entry name="BadgeHudGroupFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="BadgeHudGroupCornerRadius" type="Int">
            <default>8</default>
            <min>0</min>
            <max>50</max>
        </entry>
        <entry name="BadgeHudGroupShaderEnabled" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeLivePreviews" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeShowIcon" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeShowThumbnail" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeWindowShowIcon" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeWindowShowThumbnail" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BadgeWindowIconSize" type="Int">
            <default>20</default>
            <min>12</min>
            <max>500</max>
        </entry>
        <entry name="BadgeWindowThumbnailSize" type="Int">
            <default>56</default>
            <min>16</min>
            <max>2500</max>
        </entry>
        <entry name="BadgeWindowThumbnailWidth" type="Int">
            <default>56</default>
            <min>16</min>
            <max>2500</max>
        </entry>
        <entry name="BadgeWindowThumbnailHeight" type="Int">
            <default>32</default>
            <min>16</min>
            <max>2500</max>
        </entry>
        <entry name="BadgeWindowLetterFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeWindowLabelFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudShowIcon" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeHudShowThumbnail" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeHudIconSize" type="Int">
            <default>24</default>
            <min>12</min>
            <max>500</max>
        </entry>
        <entry name="BadgeHudThumbnailSize" type="Int">
            <default>80</default>
            <min>24</min>
            <max>3500</max>
        </entry>
        <entry name="BadgeHudThumbnailWidth" type="Int">
            <default>80</default>
            <min>24</min>
            <max>3500</max>
        </entry>
        <entry name="BadgeHudThumbnailHeight" type="Int">
            <default>48</default>
            <min>16</min>
            <max>3500</max>
        </entry>
        <entry name="BadgeHudLetterFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudCaptionFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudLocationFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudNavFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudHintsFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeHudShowHints" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeJumpSize" type="Int">
            <default>34</default>
            <min>16</min>
            <max>500</max>
        </entry>
        <entry name="BadgeHudSize" type="Int">
            <default>44</default>
            <min>24</min>
            <max>500</max>
        </entry>
        <entry name="BadgeIconSize" type="Int">
            <default>20</default>
            <min>12</min>
            <max>500</max>
        </entry>
        <entry name="BadgeThumbnailWidth" type="Int">
            <default>56</default>
            <min>24</min>
            <max>2500</max>
        </entry>
        <entry name="BadgeThumbnailHeight" type="Int">
            <default>32</default>
            <min>16</min>
            <max>2500</max>
        </entry>
        <entry name="BadgeCornerRadius" type="Int">
            <default>6</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeOpacity" type="Int">
            <default>92</default>
            <min>10</min>
            <max>100</max>
        </entry>
        <entry name="BadgeHudMarkColorMode" type="Int">
            <default>0</default>
            <min>0</min>
            <max>2</max>
        </entry>
        <entry name="BadgeLetterColorAuto" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeLabelColorAuto" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeCaptionColorAuto" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeLocationColorAuto" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BadgeDefaultColor" type="Color">
            <default>#232629</default>
        </entry>
        <entry name="BadgeLetterColor" type="Color">
            <default>#ffffff</default>
        </entry>
        <entry name="BadgeLabelUnmarkedColor" type="Color">
            <default>#f1c40f</default>
        </entry>
        <entry name="BadgeCaptionColor" type="Color">
            <default>#dce1e6</default>
        </entry>
        <entry name="BadgeLocationColor" type="Color">
            <default>#f1c40f</default>
        </entry>
        <entry name="BadgeLetterFont" type="String">
            <default></default>
        </entry>
        <entry name="BadgeLabelFont" type="String">
            <default></default>
        </entry>
        <entry name="BadgeCaptionFont" type="String">
            <default></default>
        </entry>
        <entry name="BadgeLocationFont" type="String">
            <default></default>
        </entry>
        <entry name="BadgeLetterFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeLabelFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeCaptionFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>
        <entry name="BadgeLocationFontSize" type="Int">
            <default>0</default>
            <min>0</min>
            <max>200</max>
        </entry>

        <!-- Color Cycling Settings -->
        <entry name="ColorCycleEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="ColorList" type="String">
            <default>#3daee9:3.0;#2ecc71:3.0;#9b59b6:3.0</default>
        </entry>
        <entry name="ColorTransitionDuration" type="Double">
            <default>2.0</default>
            <min>0.1</min>
            <max>30.0</max>
        </entry>
        <entry name="ColorCycleOrder" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <entry name="ColorCycleEasing" type="Int">
            <default>0</default>
            <min>0</min>
            <max>3</max>
        </entry>

        <!-- Shader / Animation Effects -->
        <entry name="BreatheEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BreatheSpeed" type="Double">
            <default>0.5</default>
            <min>0.01</min>
            <max>20.0</max>
        </entry>
        <entry name="BreatheIntensity" type="Int">
            <default>40</default>
            <min>10</min>
            <max>100</max>
        </entry>

        <entry name="GlitchEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="GlitchSpeed" type="Double">
            <default>1.0</default>
            <min>0.1</min>
            <max>5.0</max>
        </entry>
        <entry name="GlitchIntensity" type="Int">
            <default>50</default>
            <min>10</min>
            <max>100</max>
        </entry>
        <entry name="GlitchAnomalyEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="GlitchFrequency" type="Int">
            <default>3</default>
            <min>1</min>
            <max>10</max>
        </entry>

        <entry name="NeonFlickerEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="NeonFlickerInterval" type="Double">
            <default>3.0</default>
            <min>0.5</min>
            <max>30.0</max>
        </entry>
        <entry name="NeonFlickerDuration" type="Double">
            <default>0.25</default>
            <min>0.05</min>
            <max>2.0</max>
        </entry>
        <entry name="NeonFlickerIntensity" type="Int">
            <default>30</default>
            <min>10</min>
            <max>100</max>
        </entry>

        <entry name="FlashEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="FlashInterval" type="Double">
            <default>4.0</default>
            <min>0.5</min>
            <max>20.0</max>
        </entry>
        <entry name="FlashDuration" type="Double">
            <default>0.15</default>
            <min>0.05</min>
            <max>1.0</max>
        </entry>
        <entry name="CustomShaderEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="ActiveCustomShaderId" type="String">
            <default></default>
        </entry>
        <entry name="ActiveThemeId" type="String">
            <default>default-breeze</default>
        </entry>
        <entry name="ActiveThemeParams" type="String">
            <default></default>
        </entry>

        <!-- AI Assistant Settings -->
        <entry name="AiEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="AiBackend" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <entry name="AiLocalModelPath" type="String">
            <default></default>
        </entry>
        <entry name="AiApiEndpoint" type="String">
            <default>https://api.openai.com/v1</default>
        </entry>
        <entry name="AiApiModel" type="String">
            <default>gpt-4o-mini</default>
        </entry>
        <entry name="AiApiKey" type="String">
            <default></default>
        </entry>
        <entry name="AiApiProviderPreset" type="Int">
            <default>1</default>
            <min>0</min>
            <max>5</max>
        </entry>
        <entry name="AiShortcut" type="String">
            <default>Meta+I</default>
        </entry>
    </group>
</kcfg>
